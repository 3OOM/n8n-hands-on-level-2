      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn [{\n  json: {\n    warehouseSyncStatus: \"SUCCESS\",\n    totalCustomerProfilesSynced: items.length,\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
