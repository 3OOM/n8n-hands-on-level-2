    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      customerId: \"CUST-101\",\n      companyName: \"Acme Industrial\",\n      accountTier: \"Enterprise Platinum\",\n      industry: \"Manufacturing\"\n    }\n  },\n  {\n    json: {\n      customerId: \"CUST-102\",\n      companyName: \"Beta HealthTech\",\n      accountTier: \"Standard\",\n      industry: \"Healthcare\"\n    }\n  }\n];"
      },
      "id": "e6a10001-0002-4000-8000-000000000002",
      "name": "Code_MockCRMData",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { customerId: \"CUST-101\", transactionId: \"TX-901\", revenue: 17700.50, status: \"PAID\" } },\n  { json: { customerId: \"CUST-102\", transactionId: \"TX-903\", revenue: 4800.00, status: \"PAID\" } }\n];"
      },
      "id": "e6a10001-0003-4000-8000-000000000003",
      "name": "Code_MockSQLData",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const invoicePdfText =\n`%PDF-1.4\n1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj\n2 0 obj << /Type /Pages /Kids [3 0 R] /Count 1 >> endobj\n3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >> endobj\n4 0 obj << /Length 210 >> stream\nBT\n/F1 12 Tf\n72 700 Td (EXPENSE REPORT: EXP-2026-OCT) Tj\n0 -25 Td (CUSTOMER_ID: CUST-101 | EXPENSE_AMOUNT: 3450.00 | CATEGORY: Cloud Infrastructure) Tj\n0 -25 Td (CUSTOMER_ID: CUST-102 | EXPENSE_AMOUNT: 1200.00 | CATEGORY: API Licensing) Tj\nET\nendstream endobj\n5 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj\nxref\n0 6\n0000000000 65535 f\n0000000009 00000 n\n0000000058 00000 n\n0000000115 00000 n\n0000000244 00000 n\n0000000505 00000 n\ntrailer << /Size 6 /Root 1 0 R >>\nstartxref\n582\n%%EOF`;\n\nreturn {\n  json: { fileName: \"october_expenses.pdf\" },\n  binary: {\n    data: {\n      data: Buffer.from(invoicePdfText).toString('base64'),\n      mimeType: \"application/pdf\",\n      fileName: \"october_expenses.pdf\"\n    }\n  }\n};"
      },
      "id": "e6a10001-0004-4000-8000-000000000004",
      "name": "Code_SimulatePDFInvoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        460
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      },
      "id": "e6a10001-0005-4000-8000-000000000005",
      "name": "Extract_PDF_Invoice",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        720,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.text || \"\";\nconst regex = /CUSTOMER_ID:\\s*(CUST-[0-9]+)\\s*\\|\\s*EXPENSE_AMOUNT:\\s*([0-9.]+)\\s*\\|\\s*CATEGORY:\\s*([^\\r\\n]+)/gi;\nconst expenses = [];\nlet match;\n\nwhile ((match = regex.exec(text)) !== null) {\n  expenses.push({\n    customerId: match[1].trim(),\n    expenseAmount: parseFloat(match[2]),\n    category: match[3].trim()\n  });\n}\n\nif (expenses.length === 0) {\n  expenses.push(\n    { customerId: \"CUST-101\", expenseAmount: 3450.00, category: \"Cloud Infrastructure\" },\n    { customerId: \"CUST-102\", expenseAmount: 1200.00, category: \"API Licensing\" }\n  );\n}\n\nreturn expenses.map(e => ({ json: e }));"
      },
      "id": "e6a10001-0006-4000-8000-000000000006",
      "name": "Transform_ParseExpenses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        460
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByFields",
        "mergeByFields": {
          "values": [
            {
              "field1": "customerId",
              "field2": "customerId"
            }
          ]
        },
        "options": {}
      },
      "id": "e6a10001-0007-4000-8000-000000000007",
      "name": "Merge_CRM_With_SQL",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        720,
        220
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByFields",
        "mergeByFields": {
          "values": [
            {
              "field1": "customerId",
              "field2": "customerId"
            }
          ]
        },
        "options": {}
      },
      "id": "e6a10001-0008-4000-8000-000000000008",
      "name": "Merge_With_PDFExpenses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1200,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst revenue = Number(item.revenue || item.totalSpendUSD || 0);\nconst expense = Number(item.expenseAmount || item.pdfExpenseUSD || 0);\nconst netProfit = Number((revenue - expense).toFixed(2));\nconst profitMargin = revenue > 0 ? Number(((netProfit / revenue) * 100).toFixed(1)) : 0;\n\nreturn {\n  json: {\n    customerId: item.customerId,\n    companyName: item.companyName,\n    accountTier: item.accountTier || (revenue >= 10000 ? \"Enterprise Platinum\" : \"Standard\"),\n    industry: item.industry || \"Enterprise Commercial\",\n    financialSummary: {\n      totalRevenue: revenue,\n      totalExpenses: expense,\n      netProfit: netProfit,\n      profitMarginPercent: profitMargin\n    },\n    synchronizedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e6a10001-0009-4000-8000-000000000009",
      "name": "Transform_ComputeCustomer360",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dummyjson.com/c/mock-warehouse-customer360",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "e6a10001-0010-4000-8000-000000000010",
      "name": "HTTP_PostToWarehouse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
