    {
      "parameters": {
        "content": "## 📄 2. Binary PDF Extraction & Regex Parsing\n- `Extract_PDF_Invoice`: Uses n8n's native PDF parser to read binary text stream.\n- `Transform_ParseExpenses`: JavaScript Regex extraction parses line items into structured JSON: `customerId`, `expenseAmount`, `category`.",
        "height": 220,
        "width": 380,
        "color": 4
      },
      "id": "e6a10001-0013-4000-8000-000000000013",
      "name": "Sticky_PDF_Extraction",
