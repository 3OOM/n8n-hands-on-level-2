        "options": {}
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Mock_Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        380,
        360
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "clean_order_id",
              "name": "orderId",
              "value": "={{ $json.orderId.trim().toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "clean_customer_name",
              "name": "customerName",
              "value": "={{ $json.customerName.trim().split(' ').filter(w => w.length > 0).map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ') }}",
              "type": "string"
            },
            {
              "id": "clean_customer_email",
              "name": "customerEmail",
              "value": "={{ $json.customerEmail.trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "clean_email_domain",
              "name": "emailDomain",
              "value": "={{ $json.customerEmail.includes('@') ? $json.customerEmail.trim().toLowerCase().split('@')[1] : 'unknown.com' }}",
              "type": "string"
            },
            {
              "id": "clean_amount",
              "name": "amount",
              "value": "={{ Number($json.amount) }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Clean_Strings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        580,
        360
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "formatted_purchase_date",
              "name": "formattedPurchaseDate",
              "value": "={{ $dateTime.fromISO($node[\"Mock_Data\"].json.purchaseDate).toFormat('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            },
            {
              "id": "sla_due_date",
              "name": "slaDueDate",
              "value": "={{ $dateTime.fromISO($node[\"Mock_Data\"].json.purchaseDate).plus({ days: 3 }).toFormat('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Format_Dates",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        780,
        360
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "order_priority",
              "name": "priority",
              "value": "={{ $node[\"Clean_Strings\"].json.amount >= 1000 ? 'High' : ($node[\"Clean_Strings\"].json.amount >= 250 ? 'Medium' : 'Low') }}",
              "type": "string"
            },
            {
              "id": "customer_tier",
              "name": "customerTier",
              "value": "={{ $node[\"Clean_Strings\"].json.amount >= 1000 ? 'Tier 1 (Enterprise)' : ($node[\"Clean_Strings\"].json.amount >= 250 ? 'Tier 2 (Commercial)' : 'Tier 3 (Standard)') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Categorize_Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        980,
        360
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "final_invoice_object",
              "name": "invoice",
              "value": "={{ \n  {\n    invoiceId: 'INV-' + $node['Clean_Strings'].json.orderId,\n    orderId: $node['Clean_Strings'].json.orderId,\n    customer: {\n      name: $node['Clean_Strings'].json.customerName,\n      email: $node['Clean_Strings'].json.customerEmail,\n      domain: $node['Clean_Strings'].json.emailDomain,\n      tier: $node['Categorize_Order'].json.customerTier\n    },\n    fulfillment: {\n      orderDate: $node['Format_Dates'].json.formattedPurchaseDate,\n      slaDueDate: $node['Format_Dates'].json.slaDueDate,\n      priority: $node['Categorize_Order'].json.priority\n    },\n    financials: {\n      subtotal: $node['Clean_Strings'].json.amount,\n      currency: 'USD'\n    },\n    metadata: {\n      status: 'NORMALIZED_AND_INVOICED',\n      processedAt: '2026-10-15T13:52:00.000Z'\n    }\n  }\n}}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "Map_Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1180,
        360
      ]
    }
  ],
