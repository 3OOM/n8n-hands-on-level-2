                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-503",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 503,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "e8a10001-0005-4000-8000-000000000005",
      "name": "Switch_ErrorTaxonomy",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1120,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    status: \"TRANSACTION_SUCCESS\",\n    event: \"PRIMARY_TRANSACTION_SUCCEEDED\",\n    processed: true,\n    completedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e8a10001-0006-4000-8000-000000000006",
      "name": "Code_LogSuccess",
