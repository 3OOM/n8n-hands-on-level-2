      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://postman-echo.com/post",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"failoverEvent\": \"PRIMARY_GATEWAY_503_OUTAGE\",\n  \"routedGateway\": \"Secondary Cloud Provider\",\n  \"failoverTimestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "e8a10001-0010-4000-8000-000000000010",
      "name": "HTTP_FailoverGateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        560
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    status: \"SUCCESS_VIA_BACKUP_PROVIDER\",\n    backupGateway: \"Simulated Secondary Cloud Provider\",\n    failoverAcknowledged: true,\n    failoverTransactionId: \"TX-BK-\" + Math.random().toString(36).substring(2, 9).toUpperCase(),\n    recoveredAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e8a10001-0011-4000-8000-000000000011",
      "name": "Code_AuditFailover",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        560
      ]
    },
