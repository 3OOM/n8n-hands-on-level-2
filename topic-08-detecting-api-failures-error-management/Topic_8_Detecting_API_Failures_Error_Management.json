      "typeVersion": 2,
      "position": [
        1400,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    status: \"RESOURCE_NOT_FOUND\",\n    action: \"NOTIFY_DEVELOPER\",\n    quarantined: true,\n    scenario: \"CLIENT_ERROR_NOT_FOUND\",\n    isolatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e8a10001-0007-4000-8000-000000000007",
      "name": "Code_LogMissingResource",
      "type": "n8n-nodes-base.code",
