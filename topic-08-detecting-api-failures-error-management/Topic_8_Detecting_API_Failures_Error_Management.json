    {
      "parameters": {
        "jsCode": "return [\n  { json: { scenario: \"SUCCESS\", expectedStatus: 200, path: \"/status/200\" } },\n  { json: { scenario: \"CLIENT_ERROR_NOT_FOUND\", expectedStatus: 404, path: \"/status/404\" } },\n  { json: { scenario: \"RATE_LIMITED\", expectedStatus: 429, path: \"/status/429\" } },\n  { json: { scenario: \"SERVER_OUTAGE\", expectedStatus: 503, path: \"/status/503\" } }\n];"
      },
      "id": "e8a10001-0002-4000-8000-000000000002",
      "name": "Code_SimulateScenarios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://httpbin.org' + $json.path }}",
        "options": {}
      },
      "id": "e8a10001-0003-4000-8000-000000000003",
      "name": "HTTP_PrimaryGateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        340
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst error = item.error;\nlet statusCode = 200;\nlet category = \"SUCCESS\";\n\nif (error) {\n  statusCode = error.statusCode || error.status || 500;\n  if (statusCode === 404) category = \"NOT_FOUND\";\n  else if (statusCode === 429) category = \"RATE_LIMITED\";\n  else if (statusCode >= 500) category = \"SERVER_FAULT\";\n  else category = \"CLIENT_ERROR\";\n} else if (item.statusCode) {\n  statusCode = item.statusCode;\n}\n\nreturn {\n  json: {\n    statusCode: statusCode,\n    errorCategory: category,\n    rawError: error ? (error.message || JSON.stringify(error)) : null,\n    scenario: $node['Code_SimulateScenarios'].json.scenario,\n    evaluatedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e8a10001-0004-4000-8000-000000000004",
      "name": "Code_ClassifyResponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        340
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-200",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 200,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-404",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 404,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "rule-429",
                    "leftValue": "={{ $json.statusCode }}",
                    "rightValue": 429,
                    "operator": {
