{
  "name": "Topic 1 - Production Workflow Planning",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "v1/transactions",
        "responseMode": "onReceived",
        "responseData": "{\n  \"message\": \"Transaction accepted for processing\",\n  \"status\": \"ACCEPTED\"\n}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Webhook_Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        360
      ],
      "webhookId": "v1-transactions-ingest"
    },
    {
      "parameters": {
        "jsCode": "// Global memory cache simulation inside n8n workflow static data\nconst staticData = $getWorkflowStaticData('global');\nstaticData.processedTransactions = staticData.processedTransactions || [];\nconst body = $input.item.json.body || $input.item.json;\nconst transactionId = String(body.transactionId || '').trim();\n\nif (!transactionId) {\n  return {\n    json: {\n      isDuplicate: false,\n      hasId: false,\n      payload: body,\n      errorMsg: 'Missing required transactionId'\n    }\n  };\n}\n\n// Check if transaction ID already exists in cache\nconst isDuplicate = staticData.processedTransactions.includes(transactionId);\nif (!isDuplicate) {\n  // Store key with limit to prevent memory bloat\n  staticData.processedTransactions.push(transactionId);\n  if (staticData.processedTransactions.length > 500) {\n    staticData.processedTransactions.shift(); // Evict oldest\n  }\n}\n\nreturn {\n  json: {\n    transactionId: transactionId,\n    isDuplicate: isDuplicate,\n    hasId: true,\n    payload: body\n  }\n};"
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Code_CheckIdempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        360
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_duplicate_check",
              "leftValue": "={{ $json.isDuplicate }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "IF_IsNewTransaction",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        640,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    event: \"TRANSACTION_BYPASSED\",\n    reason: \"Duplicate transactionId detected\",\n    transactionId: $json.transactionId,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Log_BypassDuplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.payload || {};\nconst errors = [];\n\n// 1. Email validation using standard RFC 5322 regex\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!payload.customerEmail || !emailRegex.test(payload.customerEmail)) {\n  errors.push(\"Invalid or missing 'customerEmail'\");\n}\n\n// 2. Amount validation (must be positive numerical value)\nconst amount = Number(payload.amount);\nif (isNaN(amount) || amount <= 0) {\n  errors.push(\"Field 'amount' must be a positive number greater than 0\");\n}\n\n// 3. Currency validation (ISO 4217: 3 uppercase letters)\nconst currencyRegex = /^[A-Z]{3}$/;\nif (!payload.currency || !currencyRegex.test(payload.currency)) {\n  errors.push(\"Field 'currency' must be a valid 3-letter uppercase ISO code (e.g. USD, EUR, GBP)\");\n}\n\nconst isValid = errors.length === 0;\nreturn {\n  json: {\n    transactionId: $json.transactionId,\n    isValid: isValid,\n    validationErrors: errors,\n    sanitizedPayload: {\n      transactionId: $json.transactionId,\n      customerEmail: String(payload.customerEmail || '').toLowerCase().trim(),\n      amount: amount,\n      currency: String(payload.currency || '').toUpperCase().trim(),\n      description: payload.description || 'Standard Order Charge'\n    }\n  }\n};"
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Code_ValidateSchema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond_valid_schema",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0006-4000-8000-000000000006",
      "name": "IF_IsValidPayload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1080,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    event: \"VALIDATION_FAILED\",\n    transactionId: $json.transactionId,\n    errors: $json.validationErrors,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "1a2b3c4d-0007-4000-8000-000000000007",
      "name": "Log_ValidationError",
