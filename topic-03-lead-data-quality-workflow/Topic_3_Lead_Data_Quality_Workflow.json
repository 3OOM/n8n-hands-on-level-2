      "id": "3bb8cf61-9c17-48f0-b98a-1a89c3db6d42",
      "name": "Mock_Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "673fbb39-b9ee-4712-9c47-eb54e246cf7e",
              "leftValue": "={{ Boolean($json.fullName && $json.fullName.trim().length > 0) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "a90184ce-69fe-4428-a6e5-4f323793dfbe",
              "leftValue": "={{ Boolean($json.email && $json.email.trim().length > 0) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "5f1bc09e-716b-4e69-8132-349f2b84eb92",
      "name": "Validate_Required_Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        340
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "fields": {
          "values": [
            {
              "name": "id",
              "type": "number",
              "value": "={{ $json.id }}"
            },
            {
              "name": "cleanedName",
              "type": "string",
              "value": "={{ $json.fullName.trim().split(' ').filter(part => part.length > 0).map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ') }}"
            },
            {
              "name": "cleanedEmail",
              "type": "string",
              "value": "={{ $json.email.trim().toLowerCase() }}"
            },
            {
              "name": "cleanedPhone",
              "type": "string",
              "value": "={{ $json.phone ? $json.phone.replace(/[^0-9]/g, '') : '' }}"
            },
            {
              "name": "normalizedAt",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7dcfa498-842b-4ba9-9dc8-53b70868f0cb",
      "name": "Clean_Standardize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
