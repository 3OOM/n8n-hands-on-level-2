            {
              "name": "emailHtml",
              "type": "string",
              "value": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden;\">\n  <div style=\"background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 32px 28px; text-align: center; color: #ffffff;\">\n    <h1 style=\"margin: 0 0 8px 0; font-size: 24px; font-weight: 700; color: #38bdf8;\">🚀 Welcome to the Engineering Team!</h1>\n    <p style=\"margin: 0; font-size: 15px; color: #94a3b8;\">We are thrilled to welcome you, <strong>{{ $json.Full_Name }}</strong>, as our new <strong>{{ $json.Role_Title }}</strong>.</p>\n  </div>\n  <div style=\"padding: 28px;\">\n    <p style=\"font-size: 15px; line-height: 1.6; color: #334155;\">Hello <strong>{{ $json.Full_Name }}</strong>,</p>\n    <p style=\"font-size: 14px; line-height: 1.6; color: #475569;\">Your engineering workstation and cloud permissions have been provisioned. Below are your critical first-week action items and technical resources:</p>\n    \n    <div style=\"background: #f8fafc; border-left: 4px solid #0284c7; padding: 16px; margin: 20px 0; border-radius: 4px;\">\n      <h3 style=\"margin: 0 0 10px 0; color: #0369a1; font-size: 15px;\">🛠️ Technical Tooling & Access</h3>\n      <ul style=\"margin: 0; padding-left: 20px; font-size: 14px; color: #334155; line-height: 1.8;\">\n        <li><strong>GitHub Organization:</strong> Accept your invitation at <a href=\"https://github.com/orgs/company-dev/invitation\" style=\"color: #0284c7;\">github.com/company-dev</a></li>\n        <li><strong>DevOps & Cloud:</strong> Configure AWS SSO and Docker local cluster.</li>\n        <li><strong>CI/CD Pipelines:</strong> Review deployment guidelines in our Architecture Wiki.</li>\n      </ul>\n    </div>\n\n    <div style=\"background: #f8fafc; border-left: 4px solid #10b981; padding: 16px; margin: 20px 0; border-radius: 4px;\">\n      <h3 style=\"margin: 0 0 10px 0; color: #047857; font-size: 15px;\">👥 Your Engineering Mentor</h3>\n      <p style=\"margin: 0; font-size: 14px; color: #334155; line-height: 1.6;\">\n        <strong>Alex Rivera</strong> (Staff Engineer)<br/>\n        Email: <a href=\"mailto:alex.r@company.com\" style=\"color: #047857;\">alex.r@company.com</a> | Slack: <code>@alex-rivera</code>\n      </p>\n    </div>\n\n    <p style=\"font-size: 14px; color: #64748b; line-height: 1.5;\">Join our daily team standup at <strong>10:00 AM EST</strong> on Slack channel <code>#engineering-general</code>.</p>\n    <p style=\"font-size: 14px; color: #334155; margin-top: 24px;\">Happy coding!<br/><strong>Engineering Leadership Team</strong></p>\n  </div>\n  <div style=\"background: #f1f5f9; padding: 14px 28px; text-align: center; font-size: 12px; color: #64748b;\">\n    Employee ID: {{ $json.Employee_ID }} &bull; Department: Engineering &bull; Automated Onboarding System\n  </div>\n</div>"
