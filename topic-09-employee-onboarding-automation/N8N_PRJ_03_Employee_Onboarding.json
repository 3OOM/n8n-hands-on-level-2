px solid #10b981; padding: 16px; margin: 20px 0; border-radius: 4px;\">\n      <h3 style=\"margin: 0 0 10px 0; color: #047857; font-size: 15px;\">👥 Your Department Mentor</h3>\n      <p style=\"margin: 0; font-size: 14px; color: #334155; line-height: 1.6;\">\n        <strong>{{ $json.Department_Mentor }}</strong><br/>\n        Slack: <code>@alex-rivera</code> &bull; Standup: Daily 10:00 AM EST (<code>#engineering-general</code>)\n      </p>\n    </div>\n\n    <p style=\"font-size: 14px; color: #334155; margin-top: 24px;\">Happy coding!<br/><strong>Engineering Leadership Team</strong></p>\n  </div>\n  <div style=\"background: #f1f5f9; padding: 14px 28px; text-align: center; font-size: 12px; color: #64748b;\">\n    Employee ID: {{ $json.Employee_ID }} &bull; Department: Engineering &bull; Automated Onboarding System\n  </div>\n</div>"
